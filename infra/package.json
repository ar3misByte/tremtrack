{
  "name": "@htm/infra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AWS CDK app: IoT Core, DynamoDB, Lambda, HTTP API, Cognito, SNS, budget, optional S3+CloudFront hosting.",
  "scripts": {
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy --all --require-approval never --outputs-file ../tools/aws/out/outputs.json",
    "destroy": "cdk destroy --all --force",
    "diff": "cdk diff",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1153.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1153.0",
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/client-iot": "^3.1153.0",
    "@aws-sdk/client-sns": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1146.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  }
}
